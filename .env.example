# Copy to .env.local for local work, and set the same values with your hosting provider.
# The contact form reports a failure to the visitor until all three are set.

# API key from https://resend.com
RESEND_API_KEY=
# The inbox that receives consultation requests
CONTACT_TO_EMAIL=nandy@diframe.studio
# A sender on the domain verified with Resend. It needs no mailbox of its own.
CONTACT_FROM_EMAIL=Diframe Website <website@diframe.studio>

# The site's public address, used for canonical links and the sitemap.
# Leave empty to use https://diframe.studio
NEXT_PUBLIC_SITE_URL=
